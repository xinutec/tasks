{
  "name": "tasks-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "ng build",
    "lint": "eslint src e2e playwright.config.ts && stylelint \"src/**/*.scss\"",
    "ng": "ng",
    "prebuild": "node scripts/stamp-version.mjs",
    "prelint": "node scripts/stamp-version.mjs",
    "prestart": "node scripts/stamp-version.mjs",
    "pretest": "node scripts/stamp-version.mjs",
    "stamp": "node scripts/stamp-version.mjs",
    "start": "ng serve",
    "test": "ng test tasks-web --watch=false",
    "ui-check": "playwright test",
    "shots": "playwright test -c playwright.shots.config.ts",
    "watch": "ng build --watch --configuration development",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.e2e.json",
    "lint:styles": "stylelint \"src/**/*.scss\""
  },
  "dependencies": {
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/service-worker": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@fontsource/roboto": "^5.3.0",
    "@xinutec/ui-harness": "github:xinutec/ui-harness#73fa2d574d19d20754ac9fbddb62b43d7f519e0b",
    "@xinutec/ui-scaffold": "github:xinutec/ui-harness#73fa2d574d19d20754ac9fbddb62b43d7f519e0b&path:/scaffold",
    "material-icons": "^1.13.14",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.1",
    "@playwright/test": "^1.63.0",
    "angular-eslint": "^22.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "stylelint": "^17.14.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
