        "--expect",
        "dist/tasks-web/browser",
        "--",
        "pnpm",
        "run",
        "build"
      ],
      "artifacts": [],
      "cwd": "frontend",
      "env": {
        "CI": "true"
      },
      "name": "frontend build",
      "timeout_s": 1800
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "pnpm",
        "run",
