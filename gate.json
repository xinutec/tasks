{
  "checks": [
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "cargo",
        "fmt",
        "--all",
        "--check"
      ],
      "artifacts": [],
      "cwd": ".",
      "env": {},
      "name": "formatting",
      "timeout_s": 180
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "cargo",
        "clippy",
        "--all-targets",
        "--",
        "-D",
        "warnings"
      ],
      "artifacts": [],
      "cwd": ".",
      "env": {},
      "name": "clippy",
      "timeout_s": 1800
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "cargo",
        "doc",
        "--no-deps",
        "--workspace"
      ],
      "artifacts": [],
      "cwd": ".",
      "env": {
        "RUSTDOCFLAGS": "-D rustdoc::broken_intra_doc_links"
      },
      "name": "rustdoc resolves every intra-doc link",
      "timeout_s": 900
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "nix",
        "run",
        "git+file:../dev-lint?ref=HEAD#with-test-db",
        "--",
        "--database",
        "tasks",
        "--user",
        "tasks",
        "--password",
        "tasks",
        "--port",
        "3321",
        "--url-env",
        "TASKS_TEST_DATABASE_URL",
        "--",
        "cargo",
        "test",
        "--",
        "--test-threads=1"
      ],
      "artifacts": [],
      "cwd": ".",
      "env": {},
      "name": "tests (against a real MariaDB)",
      "timeout_s": 3600
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "pnpm",
        "install",
        "--frozen-lockfile"
      ],
      "artifacts": [],
      "cwd": "frontend",
      "env": {
        "CI": "true"
      },
      "name": "frontend deps match the lockfile",
      "timeout_s": 900
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "pnpm",
        "run",
        "lint"
      ],
      "artifacts": [],
      "cwd": "frontend",
      "env": {
        "CI": "true"
      },
      "name": "frontend lint",
      "timeout_s": 900
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "pnpm",
        "run",
        "typecheck"
      ],
      "artifacts": [],
      "cwd": "frontend",
      "env": {
        "CI": "true"
      },
      "name": "frontend typecheck (e2e)",
      "timeout_s": 900
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "pnpm",
        "test"
      ],
      "artifacts": [],
      "cwd": "frontend",
      "env": {
        "CI": "true",
        "NG_BUILD_MAX_WORKERS": "1"
      },
      "name": "frontend unit tests",
      "timeout_s": 1800
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "nix",
        "run",
        "git+file:../../dev-lint?ref=HEAD#ng-build",
